<clickhouse>
  <!-- Enable S3-compatible access (MinIO) -->
  <s3>
    <endpoint>${MINIO_ENDPOINT_INTERNAL}</endpoint>
    <access_key_id>${MINIO_ROOT_USER}</access_key_id>
    <secret_access_key>${MINIO_ROOT_PASSWORD}</secret_access_key>
    <use_environment_credentials>false</use_environment_credentials>
    <region>${AWS_REGION}</region>
    <use_virtual_host_style>false</use_virtual_host_style>
  </s3>

  <!-- Recommended for local demos -->
  <merge_tree>
    <parts_to_throw_insert>3000</parts_to_throw_insert>
  </merge_tree>
</clickhouse>