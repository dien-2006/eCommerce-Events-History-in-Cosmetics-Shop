# V2 deployment. Generate real values with: python3 scripts/bootstrap.py
# Commands use --env-file .env.deploy; the original .env is not overwritten.
COMPOSE_PROJECT_NAME=cosmetics_elt_v2
BIND_ADDRESS=127.0.0.1
POSTGRES_PASSWORD=GENERATE_ME
AIRFLOW_DB_PASSWORD=GENERATE_ME
ICEBERG_DB_PASSWORD=GENERATE_ME
OPS_DB_PASSWORD=GENERATE_ME
SUPERSET_DB_PASSWORD=GENERATE_ME
MINIO_ROOT_USER=lakehouse_admin
MINIO_ROOT_PASSWORD=GENERATE_ME
S3_BUCKET=cosmetics-lakehouse-v2
S3_ENDPOINT=http://minio:9000
AWS_DEFAULT_REGION=us-east-1
CLICKHOUSE_USER=pipeline
CLICKHOUSE_PASSWORD=GENERATE_ME
CLICKHOUSE_DASHBOARD_PASSWORD=GENERATE_ME
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=GENERATE_ME
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=GENERATE_ME
AIRFLOW_JWT_SECRET=GENERATE_ME
AIRFLOW_API_SECRET=GENERATE_ME
SUPERSET_SECRET_KEY=GENERATE_ME
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=GENERATE_ME
GRAFANA_ADMIN_PASSWORD=GENERATE_ME
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
SUPERSET_PORT=8088
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
SPARK_UI_PORT=4040
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
SPARK_DRIVER_MEMORY=3g
SPARK_LOCAL_CORES=2
RAW_DATA_DIR=./data/rawdata
